# --- Forgejo ---
FORGEJO_URL=https://git.example.com/
FORGEJO_TOKEN=CHANGE_ME_token_with_repo_rw_scope

# --- AI ---
# Gemini API key (required by reviewer, optional for orchestrator PR descriptions)
GEMINI_API_KEY=CHANGE_ME_gemini_key
# Subscription OAuth token from `claude setup-token` (valid 1 year). Never set ANTHROPIC_API_KEY: workers refuse to start
CLAUDE_CODE_OAUTH_TOKEN=CHANGE_ME_output_of_claude_setup-token

# --- Claude memory hub (claude-memory-sync) ---
MEMORY_SERVER_URL=http://raspberry:8080
MEMORY_TOKEN=CHANGE_ME_hub_bearer_token

# --- Postgres ---
# Used by docker-compose (postgres service + DATABASE_URL of every service); also read by `just run-*` recipes
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Redis ---
# Event streams, control pub/sub, worker registry. Default matches docker-compose service name
REDIS_URL=redis://redis:6379

# --- Orchestrator ---
# Trigger: Go duration between Forgejo polls
POLL_INTERVAL=60s
# Max wall-time per Claude invocation (seconds)
CLAUDE_TIMEOUT=3600
# Worker default queue: concurrent steps per worker (claude queue is always 1)
DEFAULT_QUEUE_MAX_WORKERS=4
# Worker: step timeout when the workflow step sets none (Go duration)
STEP_DEFAULT_TIMEOUT=2h
# Worker: River rescues jobs stuck longer than this; must be greater than STEP_DEFAULT_TIMEOUT
JOB_RESCUE_AFTER=3h

# --- Git identity for commits ---
GIT_USER_NAME=AI Orchestrator
GIT_USER_EMAIL=ai@example.com

# --- Projects config ---
# Host path to projects.json (copy projects.example.json), mounted read-only into trigger, workers and webui
PROJECTS_CONFIG_PATH=./projects.json

# --- Webui ---
# Bind address inside the container (docker-compose exposes 127.0.0.1:8080 on host)
LISTEN_ADDR=0.0.0.0:8080

# --- Timezone (optional) ---
TZ=Europe/Rome
