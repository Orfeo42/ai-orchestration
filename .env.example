# --- Forgejo ---
FORGEJO_URL=https://git.example.com/
FORGEJO_TOKEN=CHANGE_ME_token_with_repo_rw_scope
# Comma-separated owner/repo list polled for issues
FORGEJO_ISSUE_REPOS=owner/repo1,owner/repo2
# Optional: only process issues assigned to this user
FORGEJO_ASSIGNEE=

# --- AI ---
# Gemini API key (required by reviewer, optional for orchestrator PR descriptions)
GEMINI_API_KEY=CHANGE_ME_gemini_key
# Claude Code CLI auth is provided via config/claude/.credentials.json inside the image

# --- Redis ---
# Default matches docker-compose service name
REDIS_URL=redis://redis:6379

# --- Orchestrator ---
# Seconds between issue polls
POLL_INTERVAL=60
# Max wall-time per Claude invocation (seconds)
CLAUDE_TIMEOUT=3600

# --- Git identity for commits ---
GIT_USER_NAME=AI Orchestrator
GIT_USER_EMAIL=ai@example.com

# --- Projects config ---
# Host path to projects.json, mounted read-only into orchestrator
PROJECTS_CONFIG_PATH=./projects.json

# --- Webui ---
# Bind address inside the container (docker-compose exposes 127.0.0.1:8080 on host)
LISTEN_ADDR=0.0.0.0:8080

# --- Timezone (optional) ---
TZ=Europe/Rome
